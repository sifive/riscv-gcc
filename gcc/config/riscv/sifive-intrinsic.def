// SiFive Scalar Coprocessor Interface.
RISCV_BUILTIN (sifive_sci_x_xx_si, "sf_sci_x_xx32", RISCV_BUILTIN_DIRECT, RISCV_USI_FTYPE_SI_SI_USI_USI, xsfsci32),
RISCV_BUILTIN (sifive_sci_x_xx_di, "sf_sci_x_xx64", RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_SI_SI_UDI_UDI, xsfsci64),
RISCV_BUILTIN (sifive_sci_xx_si, "sf_sci_xx32", RISCV_BUILTIN_DIRECT_NO_TARGET, RISCV_VOID_FTYPE_SI_SI_USI_USI, xsfsci32),
RISCV_BUILTIN (sifive_sci_xx_di, "sf_sci_xx64", RISCV_BUILTIN_DIRECT_NO_TARGET, RISCV_VOID_FTYPE_SI_SI_UDI_UDI, xsfsci64),
